// ===========================================
// Bin Norouk Museum - Prisma Schema
// ===========================================
// Database: PostgreSQL (Neon)
// All translatable fields have Ar/En suffixes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

// ─── Authentication & Users ───────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("users")
}

// ─── Museum Halls ─────────────────────────────────────

model MuseumHall {
  id               String   @id @default(cuid())
  slug             String   @unique
  titleAr          String
  titleEn          String
  descriptionAr    String
  descriptionEn    String
  longDescriptionAr String?  
  longDescriptionEn String?  
  imagePath        String   @default("/images/museum/placeholders/hall-default.jpg")
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  collectionItems CollectionItem[]
  images          HallImage[]

  @@map("museum_halls")
}

// ─── Hall Gallery Images ──────────────────────────────

model HallImage {
  id        String   @id @default(cuid())
  hallId    String
  path      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  hall MuseumHall @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@map("hall_images")
}

// ─── Guestbook (visitor testimonials, admin-approved) ──

model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  origin    String?
  message   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("guestbook_entries")
}

// ─── Collection Categories ────────────────────────────

model CollectionCategory {
  id     String @id @default(cuid())
  nameAr String
  nameEn String
  slug   String @unique

  collectionItems CollectionItem[]

  @@map("collection_categories")
}

// ─── Collection Items ─────────────────────────────────

model CollectionItem {
  id                 String   @id @default(cuid())
  titleAr            String
  titleEn            String
  descriptionAr      String
  descriptionEn      String
  longDescriptionAr  String?  
  longDescriptionEn  String?  
  categoryId         String
  hallId             String?
  period             String?
  imagePath          String   @default("/images/museum/placeholders/item-default.jpg")
  condition          String?
  historicalNoteAr   String?  
  historicalNoteEn   String?  
  featured           Boolean  @default(false)
  published          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category CollectionCategory @relation(fields: [categoryId], references: [id])
  hall     MuseumHall?        @relation(fields: [hallId], references: [id])

  @@map("collection_items")
}

// ─── Bookings ─────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum VisitType {
  INDIVIDUAL
  FAMILY
  SCHOOL
  GROUP
  OFFICIAL_DELEGATION
}

model Booking {
  id               String        @id @default(cuid())
  fullName         String
  email            String
  phone            String
  visitType        VisitType
  preferredDate    DateTime
  preferredTime    String
  numberOfVisitors Int
  notes            String?       
  status           BookingStatus @default(PENDING)
  adminNotes       String?       
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("bookings")
}

// ─── Contact Messages ─────────────────────────────────

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  category   String   @default("general")
  subject    String
  message    String   
  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("contact_messages")
}

// ─── News & Events ────────────────────────────────────

enum NewsEventType {
  NEWS
  EVENT
}

model NewsEvent {
  id        String        @id @default(cuid())
  slug      String        @unique
  titleAr   String
  titleEn   String
  excerptAr String?
  excerptEn String?
  contentAr String        
  contentEn String        
  type      NewsEventType @default(NEWS)
  imagePath String?
  featured  Boolean       @default(false)
  published Boolean       @default(true)
  eventDate DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("news_events")
}

// ─── Site Settings ────────────────────────────────────

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueAr   String   
  valueEn   String   
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Audit Log ────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?  
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
